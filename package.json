{
  "name": "create-cove",
  "version": "1.3.0",
  "description": "Create a project with Cove Stack.",
  "homepage": "https://github.com/mugnavo/create-cove#readme",
  "bugs": {
    "url": "https://github.com/mugnavo/create-cove/issues"
  },
  "license": "MIT",
  "author": "Nathaniel Tampus <nat@nize.ph>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mugnavo/create-cove.git"
  },
  "bin": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format && pnpm run lint",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run test --run && pnpm run build",
    "deps": "pnpm dlx taze@latest -Ilw",
    "test": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@types/node": "26.6.3",
    "citty": "0.2.2",
    "giget": "3.3.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tinyexec": "1.3.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
